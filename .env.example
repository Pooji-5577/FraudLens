# Optional Azure OpenAI narrative reports. Never commit real credentials.
# Copy this file to .env and fill in real values there; .env is gitignored.

# Azure Portal -> your Azure OpenAI resource -> "Keys and Endpoint" -> KEY 1 (or KEY 2).
AZURE_OPENAI_API_KEY=replace-with-your-api-key

# Azure Portal -> your Azure OpenAI resource -> "Keys and Endpoint" -> Endpoint.
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com

# Azure Portal -> your Azure OpenAI resource -> "Model deployments" -> the deployment name
# you chose when deploying a chat model (this is the deployment name, not the base model name).
AZURE_OPENAI_DEPLOYMENT_NAME=your-chat-model-deployment

# The Azure OpenAI REST API version to call. Defaults to the current stable v1 surface;
# use a dated version (e.g. 2024-10-21) if your resource requires one.
AZURE_OPENAI_API_VERSION=v1


# Dashboard scoring service location.
SCORING_API_URL=http://localhost:8000

# Razorpay Partner application OAuth credentials. Create development and production
# clients in Partner Dashboard -> Applications. Keep the secret server-side.
RAZORPAY_CLIENT_ID=replace-with-your-client-id
RAZORPAY_CLIENT_SECRET=replace-with-your-client-secret
RAZORPAY_REDIRECT_URI=http://localhost:8501
RAZORPAY_MODE=test
# When Partner credentials are absent, default to a clearly labelled mock
# session for local demo safety. Set false to require real configuration.
RAZORPAY_MOCK_AUTH=true

# Local automated tests may set this to true. Never enable it in a deployed app.
RAZORPAY_AUTH_DISABLED=false
